<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.qci.infra.check</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/qci-infra/.venv/bin/qci-infra</string>
    <string>check</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/qci-infra/check.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/qci-infra/check.log</string>
</dict>
</plist>
